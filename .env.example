# 电子衣柜 —— 环境变量示例（复制成 .env 后按需修改）
# 全部为 EW_ 前缀，未设置时用括号里的默认值

# SQLite 文件位置（<仓库>/data/wardrobe.db）
# EW_DATABASE_URL=sqlite:///C:/path/to/wardrobe.db

# 数据与媒体目录
# EW_DATA_DIR=./data
# EW_MEDIA_DIR=./media

# 单张原图上限，字节（12MB）
# EW_MAX_UPLOAD_BYTES=12582912

# --- LLM（可选）------------------------------------------------------------
# 不配就走规则推荐，不会报错。
# 优先级：请求头 X-LLM-Key > 这里的 EW_LLM_KEY
# 可用模型：deepseek-chat（默认，实测 735ms / 6 tokens）、deepseek-v4-pro
# flash 是推理模型，每次多烧 100–170 reasoning tokens，选衣这种小任务不划算
# EW_LLM_KEY=sk-xxxx
# EW_LLM_BASE_URL=https://api.deepseek.com
# EW_LLM_MODEL=deepseek-chat
# EW_LLM_MAX_TOKENS=800
# EW_LLM_CACHE_TTL=1800          # 推荐结果缓存秒数（只缓存模型成功的结果）
# EW_LLM_RATE_LIMIT_PER_MIN=10   # 每个客户端每分钟能真正调模型几次

# 天气上游地址（默认 Open-Meteo）。指到不可达地址可用来验证降级。
# EW_WEATHER_URL=https://api.open-meteo.com
# 上游失败后多久不再重试（秒）；期间用内存/DB 快照兜底，避免每个请求都白等超时。
# EW_WEATHER_COOLDOWN_SECONDS=60

# 录入预填（品类/厚薄）的置信度阈值：低于它就只返回 no_key/低置信，不给建议。
# EW_CLASSIFY_MIN_CONFIDENCE=0.6
